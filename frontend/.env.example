# Copy to .env and fill in as needed.

# WalletConnect Cloud project id (https://cloud.reown.com/). Required for
# WalletConnect-based wallets; injected/RainbowKit still works without it.
VITE_WALLETCONNECT_PROJECT_ID=

# Sepolia RPC used by the wallet transports. Any Alchemy / Infura / drpc URL.
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Optional: override the deployed contract addresses for a given chain without
# re-running `npm run sync:contracts`. If all four plus VITE_CHAIN_ID are set
# and VITE_CHAIN_ID matches the connected chain, these take precedence over
# src/contracts/addresses.json.
VITE_CHAIN_ID=11155111
VITE_PROJECT_REGISTRY=
VITE_CARBON_CREDIT=
VITE_MARKETPLACE=
VITE_OFFSET_ROUTER=

# Set to the API origin, with no /api/v1 suffix. The dev server proxies to :4000 when empty.
VITE_API_URL=
VITE_MOCK_API=false
