# Local PostgreSQL from docker compose.
DATABASE_URL="postgresql://ucs:ucs@localhost:54329/ucs?schema=public"
PORT=4000

# Generate separate 32-byte secrets with: openssl rand -hex 32
JWT_SECRET=""
DEVICE_SECRET_ENCRYPTION_KEY=""

# TradeAnchor RPC, deployment address, and the contract owner's signing key.
# The API can serve settled trades before the contract is configured.
ANCHOR_RPC_URL="http://127.0.0.1:8546"
ANCHOR_PRIVATE_KEY=""
TRADE_ANCHOR_ADDRESS=""
# Optional starting block for recovering confirmation events with no recorded submission block.
ANCHOR_DEPLOYMENT_BLOCK=0

# Legacy ERC1155 credit minting runs independently of the PostgreSQL ledger.
LEGACY_MINT_ENABLED=false
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
PRIVATE_KEY=""
# CARBON_CREDIT_ADDRESS=""
# PROJECT_REGISTRY_ADDRESS=""
EMISSION_FACTOR_KG_PER_KWH=0.71
DEMO_AMPLIFY=100
DEMO_MIN_CREDITS=1
