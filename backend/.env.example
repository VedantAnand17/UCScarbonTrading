DATABASE_URL="file:./dev.db"

# Shared secret for admin routes (device provisioning/revocation).
# TEMP stand-in for real JWT+RBAC auth (see prd.md Admin role) —
# sent as "Authorization: Bearer <this value>".
ADMIN_API_KEY="replace-with-a-long-random-value"

# 32-byte (64 hex char) key used to encrypt device secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_SECRET_ENCRYPTION_KEY="replace-with-64-hex-chars"

PORT=4000

# --- On-chain minting (Sepolia) ---
# Public RPC needs no API key. Swap for Alchemy/Infura if you hit rate limits.
SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"

# MUST be the CarbonCredit/ProjectRegistry contract owner's private key
# (0x4db8B3faF4F26c04d6E456e8D5A0c02941eb772e per README.md's deployment).
# Never paste this into chat/logs — edit this file directly. Testnet-only
# key; still don't commit it (this file is gitignored, .env.example is not).
PRIVATE_KEY=""

# Override only if you redeploy the contracts — otherwise the Sepolia
# addresses from README.md are used by default.
# CARBON_CREDIT_ADDRESS=""
# PROJECT_REGISTRY_ADDRESS=""

# kWh -> credits conversion. See backend/src/lib/credits.js for why
# DEMO_AMPLIFY / DEMO_MIN_CREDITS exist — real per-reading kWh deltas are
# far too small to reach 1 whole tonne without them.
EMISSION_FACTOR_KG_PER_KWH=0.71
DEMO_AMPLIFY=100
DEMO_MIN_CREDITS=1
