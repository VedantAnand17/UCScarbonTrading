# Copy to .env and fill in. Never commit your real .env file.

# Private key of the deployer / platform operator (NO 0x prefix? Use the 0x form).
# Fund this address with Sepolia ETH from https://sepoliafaucet.com/ first.
PRIVATE_KEY=0xyourprivatekeyhere

# Sepolia RPC. Use Alchemy, Infura, drpc, etc.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Mainnet (optional, only used if you decide to deploy to mainnet later).
MAINNET_RPC_URL=

# Etherscan API key for source code verification.
ETHERSCAN_API_KEY=

# Marketplace fee in basis points (100 = 1%, max 1000 = 10%). Default 250 = 2.5%.
FEE_BPS=250

# Treasury address that collects marketplace fees. Defaults to deployer if unset.
TREASURY=

# Set SEED=1 to register two demo projects and mint some credits on deploy so
# the UI has content immediately.
SEED=1
